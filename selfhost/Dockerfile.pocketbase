FROM alpine:3.22

ARG PB_VERSION=0.42.3
ARG TARGETARCH=amd64

RUN apk add --no-cache ca-certificates curl unzip \
    && set -eux; \
       case "$TARGETARCH" in \
         amd64) PB_ARCH=amd64 ;; \
         arm64) PB_ARCH=arm64 ;; \
         *) echo "Unsupported PocketBase target architecture: $TARGETARCH" >&2; exit 1 ;; \
       esac; \
       BASE="https://ganigeorgiev.com/meta/pocketbase/pocketbase/download/v${PB_VERSION}"; \
       ARCHIVE="pocketbase_${PB_VERSION}_linux_${PB_ARCH}.zip"; \
       cd /tmp; \
       curl -fsSLo "$ARCHIVE" "$BASE/$ARCHIVE"; \
       curl -fsSLo checksums.txt "$BASE/checksums.txt"; \
       grep -E "^[[:xdigit:]]{64}[[:space:]]+${ARCHIVE}$" checksums.txt | sha256sum -c -; \
       unzip -q "$ARCHIVE" -d /pb; \
       chmod 0755 /pb/pocketbase; \
       rm -f "$ARCHIVE" checksums.txt; \
    apk del curl unzip

WORKDIR /pb
COPY pocketbase/pb_hooks/ /pb/pb_hooks/
COPY pocketbase/pb_public/ /pb/pb_public/
COPY selfhost/pocketbase-entrypoint.sh /usr/local/bin/pocketbase-entrypoint
RUN chmod 0755 /usr/local/bin/pocketbase-entrypoint && mkdir -p /pb/pb_data

EXPOSE 8090
ENTRYPOINT ["/usr/local/bin/pocketbase-entrypoint"]
