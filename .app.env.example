# Public URLs displayed by GitHub Codespaces Ports tab.
# PocketBase URL has no trailing slash.
PB_URL=https://YOUR-CODESPACE-8090.app.github.dev
# Centrifugo URL includes the WebSocket endpoint path.
CENTRIFUGO_WS=wss://YOUR-CODESPACE-8443.app.github.dev/connection/websocket
# Optional: Kinopoisk movie/series search token.
KINOPOISK_TOKEN=
# Optional: set to rustore only for a RuStore build.
STORE=
